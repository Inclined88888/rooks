# Master bearer required to issue/revoke remote tokens.
# Generate one with:  openssl rand -hex 32
ROOKS_REMOTE_MASTER=

# Accept plain HTTP on /api/remote/*. Commented out, the API answers 426 to a
# request that did not come over HTTPS. Uncommented, the remote tokens and the
# ROOKS_REMOTE_MASTER bearer above cross the network in clear text.
# Uncomment only on a network you trust, or when HTTPS ends in front of the app
# on a proxy that cannot set X-Forwarded-Proto=https. It is not needed behind
# Traefik on HTTPS (the labels inject that header) nor behind `tailscale serve`.
# This line is what the Compose app reads: "Allow remote access over HTTP" in
# Settings only reaches an app the daemon launches (`app.enabled: true`). After
# a change, recreate the container: docker compose --profile docker up -d app
# ROOKS_ALLOW_HTTP=1

# Telegram bot tokens — referenced by name in ~/.rooks/channels/<name>.json
# TELEGRAM_BOT_TOKEN=

# Webhook HMAC secrets, etc.
# STRIPE_WEBHOOK_SECRET=

# ── Orchestrator concurrency safeguards (anti-freeze) ──────────────────────
# Read by the host orchestrator (systemd rooks-orchestrator), not by Docker.
# Kanban tasks dispatched in parallel (countInProgress bound). Default 8.
# ROOKS_MAX_PARALLEL=8
# GLOBAL cap of live backend missions, ALL sources together
# (dispatcher + wake + pipeline + recovery + resume + chat). Default 12.
# ROOKS_MAX_LIVE_MISSIONS=12
# loadavg(1min) threshold, normalised per core, above which autonomous spawns
# are suspended (thermal back-pressure). Default 0.9.
# ROOKS_LOAD_THRESHOLD=0.9
# Reaper: max idle of an autonomous process before SIGTERM (ms, default 600000),
# silence of an active turn before it is judged hung (ms, default 2700000),
# duration budget of a turn even when active (ms, default 14400000, 0 = none),
# sweep period (ms, default 60000), anti-race grace at spawn (ms, default 120000).
# ROOKS_REAP_IDLE_MS=600000
# ROOKS_REAP_HUNG_MS=2700000
# ROOKS_REAP_TURN_MAX_MS=14400000
# ROOKS_REAP_INTERVAL_MS=60000
# ROOKS_REAP_ORPHAN_GRACE_MS=120000

# ── Web Push (system notifications on the phone) ───────────────────────────
# Read by the host orchestrator. Generate the pair ONCE:
#   node orchestrator/scripts/generate-vapid.mjs
# then paste the output here (in the real .env, never in .env.example).
# Without these keys the push module is inert: the UI shows "not configured"
# and no notification goes out. See docs/WEB-PUSH.md.
# ROOKS_VAPID_PUBLIC_KEY=
# ROOKS_VAPID_PRIVATE_KEY=
# ROOKS_VAPID_SUBJECT=mailto:you@example.com

# Instance marker — `dev` renames this instance to "Rooks DEV" and gives it
# its own logotype and PWA icon (app/src/lib/instance.ts). Anything else, or
# unset, is the product. Only the web app reads it: in dev the UI is served by
# the `app` container, which inherits this file. If the UI is ever served by
# the host daemon instead (`app.enabled=true`), the systemd unit rendered by
# the maintainers' sandbox script refuses `Environment=ROOKS_*` other than ROOKS_HOME —
# the marker would have to be allowed there too.
# Uncomment only on a development instance: a regular install leaves it out.
# ROOKS_INSTANCE=dev
