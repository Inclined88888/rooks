{
  "name": "timon-desktop",
  "version": "0.1.7",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "description": "Rooks desktop",
  "homepage": "https://github.com/Inclined88888/rooks",
  "author": {
    "name": "Rooks",
    "email": "Inclined88888@users.noreply.github.com"
  },
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "start": "electron dist/main.js",
    "test": "node ../scripts/run-tests.mjs",
    "dist": "npm run check:release && npm run build && npm run prepare:deps && electron-builder --config electron-builder.yml",
    "prepare:deps": "node scripts/prepare-daemon-deps.mjs",
    "dist:daemon": "node scripts/prepare-daemon-release.mjs",
    "test:release": "node ../scripts/run-tests.mjs scripts/release.test.mjs scripts/daemon-artefact.test.mjs",
    "test:runtime": "node scripts/runtime-node-smoke.mjs",
    "check:release": "node scripts/prepare-daemon-release.mjs --check"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@types/node": "^22.7.4",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "timonTests": {
    "imports": [
      "tsx",
      "../scripts/test-tmp-preload.mjs"
    ],
    "files": [
      "src/**/*.test.ts",
      "scripts/*.test.mjs"
    ]
  },
  "dependencies": {
    "intl-messageformat": "^12.1.4",
    "zod": "^4.1.11"
  },
  "optionalDependencies": {
    "sherpa-onnx-darwin-arm64": "1.12.37",
    "sherpa-onnx-darwin-x64": "1.12.37",
    "sherpa-onnx-linux-arm64": "1.12.37",
    "sherpa-onnx-linux-x64": "1.12.37",
    "sherpa-onnx-win-x64": "1.12.37"
  }
}
