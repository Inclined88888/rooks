<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened runtime entitlements of Rooks.app (see electron-builder.yml, mac).
  This file REPLACES electron-builder's default template: its three keys are
  copied here, and must stay. disable-library-validation is what lets the
  dictation engine load sherpa-onnx.node and libonnxruntime.dylib, which are
  not signed by our team. audio-input is the microphone: without it a signed
  build never shows the macOS prompt and captures silence (TODO #443).
  camera is the same gate for video: the built-in browser hands the camera
  to a site the user allowed, and Chromium's helpers inherit this list
  (TODO #446).
-->
<plist version="1.0">
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <key>com.apple.security.device.camera</key>
    <true/>
  </dict>
</plist>
