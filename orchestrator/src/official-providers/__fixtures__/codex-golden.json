  "Ollama Cloud: a provider block and a key, no sign-in": {
    "cmd": "codex",
    "args": [
      "exec",
      "--json",
      "--skip-git-repo-check",
      "--sandbox",
      "workspace-write",
      "--model",
      "gpt-oss:120b",
      "-"
    ],
    "env": {
      "CODEX_HOME": "<HOME>",
      "OLLAMA_API_KEY": "ollama-key-witness"
    },
    "initialStdin": "# Instructions\nAgent de test.\n\n# Task\nBonjour.",
    "config": {
      "": [
        "experimental_use_freeform_apply_patch = false",
        "model_provider = \"ollama-cloud\""
      ],
      "sandbox_workspace_write": [
        "network_access = true",
        "writable_roots = [\"<TMP>/repo/.git/worktrees/repo-wt\", \"<TMP>/repo/.git\", \"<TMP>/repo\"]"
      ],
      "mcp_servers.timon": [
        "args = [\"<TIMON_MCP>\"]",
        "command = \"node\"",
        "default_tools_approval_mode = \"approve\"",
