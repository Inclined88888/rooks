{
  "subscription, git worktree, grepai, two user servers, reasoning": {
    "cmd": "codex",
    "args": [
      "exec",
      "--json",
      "--skip-git-repo-check",
      "--sandbox",
      "workspace-write",
      "--model",
      "gpt-5.5",
      "-c",
      "model_reasoning_effort=high",
      "-"
    ],
    "env": {
      "CODEX_HOME": "<HOME>"
    },
    "initialStdin": "# Instructions\nAgent de test.\n\n# Task\nBonjour.",
    "config": {
      "sandbox_workspace_write": [
        "network_access = true",
        "writable_roots = [\"<TMP>/repo/.git/worktrees/repo-wt\", \"<TMP>/repo/.git\", \"<TMP>/repo\"]"
      ],
      "mcp_servers.timon": [
        "args = [\"<TIMON_MCP>\"]",
        "command = \"node\"",
        "default_tools_approval_mode = \"approve\"",
        "env_vars = [\"TIMON_API_TOKEN\"]"
      ],
      "mcp_servers.timon.env": [
        "TIMON_AGENT = \"parity.agent\"",
        "TIMON_HOME = \"<TIMON_HOME>\"",
        "TIMON_MISSION_ID = \"parity-2040999904\"",
        "TIMON_ORCH_URL = \"http://localhost:3010\""
      ],
      "mcp_servers.timon_ask": [
        "args = [\"<FORMS_MCP>\"]",
        "command = \"node\"",
        "default_tools_approval_mode = \"approve\"",
        "env_vars = [\"TIMON_API_TOKEN\"]"
      ],
      "mcp_servers.timon_ask.env": [
        "TIMON_AGENT = \"parity.agent\"",
        "TIMON_ASK_FORMS_ONLY = \"1\"",
        "TIMON_MISSION_ID = \"parity-2040999904\"",
        "TIMON_ORCH_URL = \"http://localhost:3010\""
      ],
      "mcp_servers.grepai": [
        "args = [\"mcp-serve\"]",
        "command = \"grepai\"",
        "default_tools_approval_mode = \"approve\""
      ],
      "mcp_servers.probe_stdio": [
        "args = [\"/tmp/probe.mjs\"]",
        "command = \"node\"",
        "default_tools_approval_mode = \"approve\""
      ],
      "mcp_servers.probe_stdio.env": [
        "PROBE_TOKEN = \"x\""
      ],
      "mcp_servers.probe_http": [
        "default_tools_approval_mode = \"approve\"",
        "url = \"http://127.0.0.1:8787/mcp\""
      ]
    },
    "authJson": "link",
    "pictures": []
  },
